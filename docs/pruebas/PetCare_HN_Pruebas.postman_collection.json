              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@huellitas.hn\",\n  \"password\": \"Admin12345*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve accessToken', () => pm.expect(j.data.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('tokenAdmin', j.data.accessToken);"
                ]
