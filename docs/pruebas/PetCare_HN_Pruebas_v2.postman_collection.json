    {
      "name": "6. Cobro real (ESCRIBE en la BD - desmarcar si no se quiere)",
      "item": [
        {
          "name": "6.1 Cobrar cita atendida (201, o 409 si ya estaba cobrada)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/citas/{{citaCobro}}/cobro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "citas",
                "{{citaCobro}}",
                "cobro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"EFECTIVO\",\n  \"referenciaTransferencia\": null,\n  \"claveIdempotencia\": \"{{claveCobro}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('claveCobro')) {",
                  "  pm.collectionVariables.set('claveCobro', 'postman-' + Date.now() + '-cobro');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 o 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "pm.collectionVariables.set('estadoCobro', String(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json().data;",
                  "  pm.collectionVariables.set('comprobanteId', String(d.id));",
                  "  pm.test('Comprobante con numero COM-', () => pm.expect(d.numeroInterno).to.match(/^COM-/));",
                  "  pm.test('Metodo EFECTIVO', () => pm.expect(d.metodo).to.eql('EFECTIVO'));",
                  "  pm.test('Trae items', () => pm.expect(d.items).to.be.an('array').that.is.not.empty);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Reintento con la misma clave (200 mismo comprobante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/citas/{{citaCobro}}/cobro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "citas",
                "{{citaCobro}}",
                "cobro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"EFECTIVO\",\n  \"referenciaTransferencia\": null,\n  \"claveIdempotencia\": \"{{claveCobro}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const creado = pm.collectionVariables.get('estadoCobro') === '201';",
                  "if (creado) {",
                  "  pm.test('Reintento devuelve 200', () => pm.response.to.have.status(200));",
                  "  pm.test('Mismo comprobante', () => pm.expect(String(pm.response.json().data.id)).to.eql(pm.collectionVariables.get('comprobanteId')));",
                  "} else {",
                  "  pm.test('Cita ya cobrada antes: 409', () => pm.response.to.have.status(409));",
                  "}"
                ]
              }
            }
          ]
        },
